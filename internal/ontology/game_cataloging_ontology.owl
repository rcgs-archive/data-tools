@prefix gc: <https://collection.rcgs.jp/gc/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://collection.rcgs.jp/gc/>
    a owl:Ontology ;
    dcterms:title "Game Cataloging Ontology"@en , "ゲーム目録オントロジー"@ja ;
    rdfs:label "Game Cataloging Ontology"@en , "ゲーム目録オントロジー"@ja ;
    skos:definition "An ontology for cataloging video game and related resources in the RCGS collection."@en , "RCGSコレクションにおけるゲームおよび関連資料の目録作業のためのオントロジー"@ja ;
    vann:preferredNamespacePrefix "gc" ;
    vann:preferredNamespaceUri <https://collection.rcgs.jp/gc/> ;
    owl:versionInfo "0.1.0" ;
    dcterms:created "2026-09-17"^^xsd:date ;
    dcterms:modified "2026-09-17"^^xsd:date ;
    dcterms:license "CC0 1.0 Universal" .

######### Class #########
gc:Thing
    a owl:Class ;
    rdfs:label "Thing"@en, "事物"@ja ;
    skos:definition "事物"@ja , "Thing"@en .

gc:Topic
    a owl:Class ;
    rdfs:label "Topic"@en, "トピック"@ja ;
    skos:definition "作品の内容を記述するためのキーワード"@ja , "Keyword for describing content of work"@en ;
    rdfs:subClassOf gc:Thing .

gc:Work
    a owl:Class ;
    rdfs:label "Work"@en , "作品"@ja ;
    skos:definition "個別の創作が反映された内容"@ja ;
    owl:equivalentClass bf:Work , schema:CreativeWork ;
    rdfs:subClassOf gc:Thing .

gc:Instance
    a owl:Class ;
    rdfs:label "Instance"@en , "インスタンス"@ja ;
    skos:definition "物理的・内容的に同じ特徴を有するリソース"@ja ;
    owl:equivalentClass bf:Instance ;
    rdfs:subClassOf gc:Thing .

gc:Item
    a owl:Class ;
    rdfs:label "Item"@en , "個別資料"@ja ;
    skos:definition "インスタンスの単一の例示"@ja ;
    owl:equivalentClass bf:Item ;
    rdfs:subClassOf gc:Thing .

gc:Variation
    a owl:Class ;
    rdfs:label "Variation"@en , "バリエーション"@ja ;
    skos:definition "同一の経験を提供するビデオゲームの創作的内容"@ja ;
    rdfs:subClassOf gc:Work .

gc:Package
    a owl:Class ;
    rdfs:label "Package"@en , "パッケージ"@ja ;
    skos:definition "作品を具体化するビデオゲームの頒布パッケージ"@ja ;
    rdfs:subClassOf gc:Instance .

gc:RelatedInstance
    a owl:Class ;
    rdfs:label "Related Instance"@en , "関連資料"@ja ;
    skos:definition "ビデオゲームに関連する、物理的に作品を具体化するリソース"@ja ;
    rdfs:subClassOf gc:Instance .

gc:PhysicalPackage
    a owl:Class ;
    rdfs:label "Physical Package"@en , "物理パッケージ"@ja ;
    skos:definition "作品を具体化するビデオゲームの物理的なキャリアを有する頒布パッケージ"@ja ;
    rdfs:subClassOf gc:Package .

gc:OnlinePackage
    a owl:Class ;
    rdfs:label "Online Package"@en , "オンラインパッケージ"@ja ;
    skos:definition "作品を具体化するビデオゲームのオンラインリソースの頒布パッケージ"@ja ;
    rdfs:subClassOf gc:Package .

gc:Contribution
    a owl:Class ;
    rdfs:label "Contribution"@en, "貢献"@ja ;
    skos:definition "創作的内容への貢献"@ja ;
    rdfs:subClassOf gc:Thing .

gc:ContentRating
    a owl:Class ;
    rdfs:label "Content Rating"@en, "コンテンツレーティング"@ja ;
    skos:definition "コンテンツの内容による年齢制限などの格付け"@ja ;
    rdfs:subClassOf gc:Thing .

gc:Device
    a owl:Class ;
    rdfs:label "Device"@en , "装置"@ja ;
    skos:definition "ゲームをプレイするための物理的な装置"@ja ;
    rdfs:subClassOf gc:Thing .

gc:MediaFormat a owl:Class ;
    rdfs:label "MediaFormat"@en , "メディア形式"@ja ;
    skos:definition "ゲームのキャリアやファイルフォーマットの分類"@ja ;
    rdfs:subClassOf gc:Thing .

gc:Platform a owl:Class ;
    rdfs:label "Platform"@en , "プラットフォーム"@ja ;
    skos:definition "ゲームプレイのための標準や仕様。e.g. プレイステーション。"@ja ;
    rdfs:subClassOf gc:Thing .

gc:ProvisionActivity a owl:Class ;
    rdfs:label "ProvisionActivity"@en , "供給活動"@ja ;
    skos:definition "リソースの制作、出版、頒布、製造といった供給のための活動の情報" ;
    owl:equivalentClass bf:ProvisionActivity ;
    rdfs:subClassOf gc:Thing .

gc:Production
    a owl:Class ;
    rdfs:label "Production"@en , "制作"@ja ;
    skos:definition "リソースの制作に関連する表示などの情報"@ja , "Statement and other information related to resource production"@en ;
    owl:equivalentClass bf:Production ;
    rdfs:subClassOf gc:ProvisionActivity .

gc:Publication
    a owl:Class ;
    rdfs:label "Publication"@en , "出版"@ja ;
    skos:definition "リソースの出版に関連する表示などの情報"@ja , "Statement and other information related to resource publication"@en ;
    owl:equivalentClass bf:Publication ;
    rdfs:subClassOf gc:ProvisionActivity .

gc:Distribution
    a owl:Class ;
    rdfs:label "Distribution"@en , "頒布"@ja ;
    skos:definition "リソースの頒布に関連する表示などの情報"@ja , "Statement and other information related to resource distribution"@en ;
    owl:equivalentClass bf:Distribution ;
    rdfs:subClassOf gc:ProvisionActivity .

gc:Manufacture
    a owl:Class ;
    rdfs:label "Manufacture"@en , "製造"@ja ;
    skos:definition "リソースの製造に関連する表示などの情報"@ja , "Statement and other information related to resource manufacture"@en ;
    owl:equivalentClass bf:Manufacture ;
    rdfs:subClassOf gc:ProvisionActivity .

gc:AdminMetadata
    a owl:Class ;
    rdfs:label "管理メタデータ"@ja , "Administration for metadata"@en ;
    skos:definition "書誌管理用のメタデータ"@ja , "Metadata for bibliography administration"@en ;
    rdfs:subClassOf gc:Thing .

gc:ConsoleGame
    a owl:Class ;
    rdfs:label "Console Game"@en , "家庭用ゲーム"@ja ;
    rdfs:subClassOf gc:Package .

gc:PCGame
    a owl:Class ;
    rdfs:label "PC Game"@en , "PCゲーム"@ja ;
    rdfs:subClassOf gc:Package .

gc:HandheldElectronicGame
    a owl:Class ;
    rdfs:label "Handheld Electronic Game"@en , "電子ゲーム"@ja ;
    rdfs:subClassOf gc:Package .

gc:TabletopGame
    a owl:Class ;
    rdfs:label "Tabletop Game"@en , "テーブルトップゲーム"@ja ;
    rdfs:subClassOf gc:Package .

gc:GameDevice
    a owl:Class ;
    rdfs:label "Game Device"@en , "ゲーム装置"@ja ;
    rdfs:subClassOf gc:Device .

gc:HandheldGameConsole
    a owl:Class ;
    rdfs:label "Handheld Game Console"@en , "家庭用携帯型ゲーム"@ja ;
    rdfs:subClassOf gc:Package .

gc:PeripheralEquipment
    a owl:Class ;
    rdfs:label "Peripheral Equipment"@en , "周辺機器"@ja ;
    rdfs:subClassOf gc:Device .

gc:PersonalComputer
    a owl:Class ;
    rdfs:label "Personal Computer"@en , "パーソナルコンピュータ"@ja ;
    rdfs:subClassOf gc:Device .

gc:TabletComputer
    a owl:Class ;
    rdfs:label "Tablet Computer"@en , "タブレットコンピュータ"@ja ;
    rdfs:subClassOf gc:Device .

gc:SmartPhone
    a owl:Class ;
    rdfs:label "Smart Phone"@en , "スマートフォン"@ja ;
    rdfs:subClassOf gc:Device .

gc:Book
    a owl:Class ;
    rdfs:label "Book"@en , "図書"@ja ;
    rdfs:subClassOf gc:RelatedInstance .

gc:StrategyGuide
    a owl:Class ;
    rdfs:label "Strategy Guide"@en , "攻略本"@ja ;
    rdfs:subClassOf gc:Book .

gc:GameBook
    a owl:Class ;
    rdfs:label "Game Book"@en , "ゲームブック"@ja ;
    rdfs:subClassOf gc:Book .

gc:FanBook
    a owl:Class ;
    rdfs:label "Fan Book"@en , "ファンブック"@ja ;
    rdfs:subClassOf gc:Book .

gc:TRPGReplay
    a owl:Class ;
    rdfs:label "TRPG Replay"@en , "TRPGリプレイ"@ja ;
    rdfs:subClassOf gc:Book .

gc:RuleBook
    a owl:Class ;
    rdfs:label "Rule Book"@en , "ルールブック"@ja ;
    rdfs:subClassOf gc:Book .

gc:Periodical
    a owl:Class ;
    rdfs:label "Periodical"@en , "逐次刊行物"@ja ;
    rdfs:subClassOf gc:RelatedInstance .

gc:Magazine
    a owl:Class ;
    rdfs:label "Magazine"@en , "雑誌"@ja ;
    rdfs:subClassOf gc:Periodical .

gc:GameMagazine
    a owl:Class ;
    rdfs:label "Game Magazine"@en , "ゲーム専門誌"@ja ;
    rdfs:subClassOf gc:Magazine .

gc:Journal
    a owl:Class ;
    rdfs:label "Journal"@en , "学術雑誌"@ja ;
    rdfs:subClassOf gc:Periodical .

gc:NewsPaper
    a owl:Class ;
    rdfs:label "News Paper"@en , "新聞"@ja ;
    rdfs:subClassOf gc:Periodical .

gc:Appendix
    a owl:Class ;
    rdfs:label "Appendix"@en , "付録"@ja ;
    rdfs:subClassOf gc:RelatedInstance .

gc:Article
    a owl:Class ;
    rdfs:label "Article"@en , "記事"@ja ;
    rdfs:subClassOf gc:RelatedInstance .

gc:AcademicArticle
    a owl:Class ;
    rdfs:label "Academic Article"@en , "学術論文"@ja ;
    rdfs:subClassOf gc:Article .

gc:AudioDocument
    a owl:Class ;
    rdfs:label "Audio Document"@en , "音声資料"@ja ;

    rdfs:subClassOf gc:RelatedInstance .

gc:Soundtrack
    a owl:Class ;
    rdfs:label "Soundtrack"@en , "サウンドトラック"@ja ;
    rdfs:subClassOf gc:AudioDocument .

gc:VisualAudioMaterial
    a owl:Class ;
    rdfs:label "Visual Audio Material"@en , "映像音声資料"@ja ;
    rdfs:subClassOf gc:RelatedInstance .

gc:Flyer
    a owl:Class ;
    rdfs:label "Flyer"@en , "フライヤー"@ja ;
    rdfs:subClassOf gc:RelatedInstance .

gc:Poster
    a owl:Class ;
    rdfs:label "Poster"@en , "ポスター"@ja ;
    rdfs:subClassOf gc:RelatedInstance .

gc:Pamphlet
    a owl:Class ;
    rdfs:label "Pamphlet"@en , "パンフレット"@ja ;
    rdfs:subClassOf gc:RelatedInstance .

gc:ModelFigure
    a owl:Class ;
    rdfs:label "Model Figure"@en , "フィギュア"@ja ;
    rdfs:subClassOf gc:RelatedInstance .

gc:Score
    a owl:Class ;
    rdfs:label "Score"@en , "楽譜"@ja ;
    rdfs:subClassOf gc:RelatedInstance .

gc:Manual
    a owl:Class ;
    rdfs:label "Manual"@en , "取扱説明書"@ja ;
    rdfs:subClassOf gc:RelatedInstance .

gc:Card
    a owl:Class ;
    rdfs:label "Card"@en , "カード"@ja ;
    rdfs:subClassOf gc:RelatedInstance .

gc:Note
    a owl:Class ;
    rdfs:label "Note"@en , "手記"@ja ;
    rdfs:subClassOf gc:RelatedInstance .

gc:InstanceProductType
    a owl:Class ;
    rdfs:label "複製資料"@ja, "Instance Product Type"@en ;
    rdfs:subClassOf gc:RelatedInstance .

gc:Software
    a owl:Class ;
    rdfs:label "ソフトウェア"@ja, "Software" ;
    rdfs:subClassOf gc:MediaFormat .


######### Property #########
gc:advertiseType a owl:DatatypeProperty ;
    rdfs:label "広報資料種別"@ja , "Advertise Type"@en ;
    skos:definition "目録対象リソースに関する広報資料種別の情報"@ja ;
    rdfs:domain gc:Instance ;
    rdfs:range rdfs:Literal .

gc:abbreviatedTitle a owl:DatatypeProperty ;
    rdfs:label "省略タイトル"@ja , "Abbreviated Title"@en ;
    skos:definition "リソースのタイトルの省略形"@ja ;
    rdfs:domain gc:Instance ;
    rdfs:range rdfs:Literal .

gc:accessCondition a owl:DatatypeProperty ;
    rdfs:label "入手条件 | 所蔵品"@ja , "Access Condition"@en ;
    skos:definition "目録対象リソースに関する入手条件 | 所蔵品の情報"@ja ;
    rdfs:domain gc:Item ;
    rdfs:range rdfs:Literal .

gc:actedCharacterName a owl:DatatypeProperty ;
    rdfs:label "演じたキャラクター名"@ja , "Acted Character Name"@en ;
    skos:definition "貢献者が演じたキャラクターの名前や名称"@ja ;
    rdfs:domain gc:Contributor ;
    rdfs:range rdfs:Literal .

gc:activityDomain a owl:DatatypeProperty ;
    rdfs:label "活動分野"@ja , "Activity Domain"@en ;
    skos:definition "目録対象リソースに関する活動分野の情報"@ja ;
    rdfs:domain foaf:Agent ;
    rdfs:range rdfs:Literal .

gc:activityPeriod a owl:DatatypeProperty ;
    rdfs:label "活動期間"@ja , "Activity Period"@en ;
    skos:definition "目録対象リソースに関する活動期間の情報"@ja ;
    rdfs:domain foaf:Agent ;
    rdfs:range rdfs:Literal .

gc:actorName a owl:DatatypeProperty ;
    rdfs:label "貢献者actedCharactor統合"@ja , "Actor Name"@en ;
    skos:definition "目録対象リソースに関する貢献者actedCharactor統合の情報"@ja ;
    rdfs:domain gc:Variation ;
    rdfs:range rdfs:Literal .

gc:additionalRequirement a owl:DatatypeProperty ;
    rdfs:label "追記要件"@ja , "Additional Requirement"@en ;
    skos:definition "目録対象リソースに関する追記要件の情報"@ja ;
    rdfs:domain gc:Instance ;
    rdfs:range rdfs:Literal .

gc:adultOrNot a owl:DatatypeProperty ;
    rdfs:label "一般・成人向"@ja , "Adult Or Not"@en ;
    skos:definition "目録対象リソースに関する一般・成人向の情報"@ja ;
    rdfs:domain gc:Instance ;
    rdfs:range xsd:boolean .

gc:agentName a owl:DatatypeProperty ;
    rdfs:label "AgentName"@ja , "Agent Name"@en ;
    skos:definition "目録対象リソースに関するAgentNameの情報"@ja ;
    rdfs:domain gc:Contributor ;
    rdfs:range rdfs:Literal .

gc:appleStore a owl:DatatypeProperty ;
    rdfs:label "AppleStoreI"@ja , "Apple Store"@en ;
    skos:definition "目録対象リソースに関するAppleStoreIの情報"@ja ;
    rdfs:domain foaf:Agent ;
    rdfs:range rdfs:Literal .

gc:aspectRatio a owl:ObjectProperty ;
    rdfs:label "アスペクト比"@ja , "Aspect Ratio"@en ;
    skos:definition "リソースの映像の動画の幅と高さの数値の比率"@ja ;
    rdfs:domain gc:Variation ;
    rdfs:range <http://rdaregistry.info/termList/AspectRatio> .

gc:box a owl:DatatypeProperty ;
    rdfs:label "箱有無"@ja , "Box"@en ;
    skos:definition "目録対象リソースに関する箱有無の情報"@ja ;
    rdfs:domain gc:Instance ;
    rdfs:range xsd:boolean .

gc:catalogerNote a owl:DatatypeProperty ;
    rdfs:label "カタロガー注記"@ja , "Cataloger Note"@en ;
    skos:definition "目録対象リソースに関するカタロガー注記の情報"@ja ;
    rdfs:range rdfs:Literal .

gc:catalogingStatus a owl:DatatypeProperty ;
    rdfs:label "目録作成状況"@ja , "Cataloging Status"@en ;
    skos:definition "目録対象リソースに関する目録作成状況の情報"@ja ;
    rdfs:range rdfs:Literal .

gc:catchCopy a owl:DatatypeProperty ;
    rdfs:label "キャッチコピー"@ja , "Catch Copy"@en ;
    skos:definition "目録対象リソースに関するキャッチコピーの情報"@ja ;
    rdfs:domain gc:Instance ;
    rdfs:range rdfs:Literal .

gc:confirmer a owl:ObjectProperty ;
    rdfs:label "確認者"@ja , "Confirmer"@en ;
    skos:definition "目録対象リソースに関する確認者の情報"@ja ;
    rdfs:domain gc:Instance ;
    rdfs:range foaf:Agent .

gc:connectivity a owl:DatatypeProperty ;
    rdfs:label "接続性"@ja , "Connectivity"@en ;
    skos:definition "目録対象リソースに関する接続性の情報"@ja ;
    rdfs:domain gc:Variation ;
    rdfs:range rdfs:Literal .

gc:connects a owl:ObjectProperty ;
    rdfs:label "接続する装置"@ja , "Connects"@en ;
    skos:definition "目録対象リソースに関する接続する装置の情報"@ja ;
    rdfs:domain gc:Device ;
    rdfs:range gc:Device .

gc:contentType a owl:DatatypeProperty ;
    rdfs:label "内容種別統合"@ja , "Content Type"@en ;
    skos:definition "目録対象リソースに関する内容種別統合の情報"@ja ;
    rdfs:domain gc:Variation ;
    rdfs:range rdfs:Literal .

gc:contributeVariation a owl:ObjectProperty ;
    rdfs:label "gc:recordID (Variation)"@ja , "Contribute Variation"@en ;
    skos:definition "目録対象リソースに関するgc:recordID (Variation)の情報"@ja ;
    rdfs:domain gc:Contributor ;
    rdfs:range gc:Variation .

gc:contributor a owl:DatatypeProperty ;
    rdfs:label "スタッフ（文字列）"@ja , "Contributor"@en ;
    skos:definition "目録対象リソースに関するスタッフ（文字列）の情報"@ja ;
    rdfs:domain gc:Variation ;
    rdfs:range rdfs:Literal .

gc:controller a owl:DatatypeProperty ;
    rdfs:label "操作入力"@ja , "Controller"@en ;
    skos:definition "リソースのコントローラーの数量や入力端子などの仕様"@ja ;
    rdfs:domain gc:Device ;
    rdfs:range rdfs:Literal .

gc:creator a owl:ObjectProperty ;
    rdfs:label "創作者"@ja , "Creator"@en ;
    skos:definition "目録対象リソースに関する創作者の情報"@ja ;
    rdfs:domain gc:Instance ;
    rdfs:range foaf:Agent .

gc:dataCreated a owl:DatatypeProperty ;
    rdfs:label "エントリ作成時"@ja , "Data Created"@en ;
    skos:definition "目録対象リソースに関するエントリ作成時の情報"@ja ;
    rdfs:range xsd:dateTime .

gc:dataCreator a owl:ObjectProperty ;
    rdfs:label "エントリ作成者"@ja , "Data Creator"@en ;
    skos:definition "目録対象リソースに関するエントリ作成者の情報"@ja ;
    rdfs:range foaf:Agent .

gc:dataModified a owl:DatatypeProperty ;
    rdfs:label "エントリ修正時"@ja , "Data Modified"@en ;
    skos:definition "目録対象リソースに関するエントリ修正時の情報"@ja ;
    rdfs:range xsd:dateTime .

gc:dataModifier a owl:ObjectProperty ;
    rdfs:label "エントリ修正者"@ja , "Data Modifier"@en ;
    skos:definition "目録対象リソースに関するエントリ修正者の情報"@ja ;
    rdfs:domain gc:Thing ;
    rdfs:range foaf:Agent .

gc:dateDistributed a owl:DatatypeProperty ;
    rdfs:label "頒布日"@ja , "Date Distributed"@en ;
    skos:definition "目録対象リソースに関する頒布日の情報"@ja ;
    rdfs:domain gc:Instance ;
    rdfs:range xsd:date .

gc:datePublished a owl:DatatypeProperty ;
    rdfs:label "出版日"@ja , "Date Published"@en ;
    skos:definition "目録対象リソースに関する出版日の情報"@ja ;
    rdfs:domain gc:Instance ;
    rdfs:range xsd:date .

gc:dateSourceAccessed a owl:DatatypeProperty ;
    rdfs:label "AccessDate"@ja , "Date Source Accessed"@en ;
    skos:definition "目録対象リソースに関するAccessDateの情報"@ja ;
    rdfs:domain gc:Contributor ;
    rdfs:range xsd:date .

gc:dateTested a owl:DatatypeProperty ;
    rdfs:label "動作確認日"@ja , "Date Tested"@en ;
    skos:definition "目録対象リソースに関する動作確認日の情報"@ja ;
    rdfs:domain gc:Item ;
    rdfs:range xsd:date .

gc:deviceImplimented a owl:ObjectProperty ;
    rdfs:label "実装される装置"@ja , "Implemented Device"@en ;
    skos:definition "プラットフォームを実装する装置"@ja ;
    rdfs:domain gc:Platform ;
    rdfs:range gc:Device .

gc:deviceType a owl:ObjectProperty ;
    rdfs:label "種別_UR"@ja , "Device Type"@en ;
    skos:definition "目録対象リソースに関する種別_URの情報"@ja ;
    rdfs:domain gc:Device ;
    rdfs:range gc:Device .

gc:difficultyOption a owl:DatatypeProperty ;
    rdfs:label "難易度の選択"@ja , "Difficulty Option"@en ;
    skos:definition "目録対象リソースに関する難易度の選択の情報"@ja ;
    rdfs:domain gc:Variation ;
    rdfs:range rdfs:Literal .

gc:digitalFileType a owl:ObjectProperty ;
    rdfs:label "デジタルファイル種別"@ja , "Digital File Type"@en ;
    skos:definition "コンピュータファイルとして符号化されたデータの内容の一般形の分類"@ja ;
    rdfs:domain gc:Instance ;
    rdfs:range <http://rdaregistry.info/termList/FileType> .

gc:dimension a owl:DatatypeProperty ;
    rdfs:label "大きさ"@ja , "Dimension"@en ;
